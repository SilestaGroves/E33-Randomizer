<!--
    A soft dark palette: graphite backgrounds and light grey text instead of white on black, and muted versions of
    the light theme's accent colours. Loaded on top of the Fluent dark theme, whose brushes it overrides.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Palette -->
    <Color x:Key="PaletteBackground">#2B2D31</Color>
    <Color x:Key="PalettePanel">#313338</Color>
    <Color x:Key="PaletteControl">#3A3D43</Color>
    <Color x:Key="PaletteControlHover">#43464D</Color>
    <Color x:Key="PaletteControlPressed">#4C5058</Color>
    <Color x:Key="PaletteInput">#26282C</Color>
    <Color x:Key="PaletteBorder">#4A4E56</Color>
    <Color x:Key="PaletteText">#D4D7DC</Color>
    <Color x:Key="PaletteTextSecondary">#A5A9B0</Color>
    <Color x:Key="PaletteTextTertiary">#8B9098</Color>
    <Color x:Key="PaletteTextDisabled">#6C7078</Color>
    <Color x:Key="PaletteAccent">#5B9EA6</Color>

    <!-- Colours of the windows themselves -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PalettePanel}" />
    <SolidColorBrush x:Key="SplitterBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="HeadingTextBrush" Color="{StaticResource PaletteText}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource PaletteTextSecondary}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E0A65A" />
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#2F6B70" />
    <SolidColorBrush x:Key="AccentButtonTextBrush" Color="#E3EFF0" />
    <SolidColorBrush x:Key="SuccessButtonBrush" Color="#3E7A45" />
    <SolidColorBrush x:Key="SuccessButtonTextBrush" Color="#E5F0E6" />
    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#4A4E55" />
    <SolidColorBrush x:Key="NeutralButtonTextBrush" Color="{StaticResource PaletteText}" />
    <SolidColorBrush x:Key="RemoveButtonBrush" Color="#5A3438" />
    <SolidColorBrush x:Key="RemoveButtonBorderBrush" Color="#8A4C52" />
    <SolidColorBrush x:Key="GroupBorderBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#9A4348" />
    <SolidColorBrush x:Key="DangerButtonTextBrush" Color="#F2E4E5" />

    <!-- Fluent theme brushes: softer text and backgrounds than the default white on near black -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource PaletteText}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource PaletteTextSecondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource PaletteTextTertiary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource PaletteTextDisabled}" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource PaletteBackground}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource PaletteBackground}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource PalettePanel}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource PaletteControl}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource PaletteControlHover}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource PalettePanel}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource PaletteBackground}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PalettePanel}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource PaletteControl}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource PaletteControlHover}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource PaletteControlPressed}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource PalettePanel}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource PaletteInput}" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource PaletteControl}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#7A7F88" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource PaletteBorder}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource PaletteControlHover}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource PaletteControlPressed}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource PaletteAccent}" />
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource PaletteAccent}" />

    <!-- The windows were laid out for the classic 12 px text and compact controls; Fluent's are bigger -->
    <sys:Double x:Key="ControlContentThemeFontSize">12</sys:Double>
    <sys:Double x:Key="ContentControlFontSize">12</sys:Double>
    <sys:Double x:Key="BodyTextBlockFontSize">12</sys:Double>
    <sys:Double x:Key="TreeViewItemFontSize">12</sys:Double>
    <sys:Double x:Key="TextControlThemeMinHeight">22</sys:Double>
    <sys:Double x:Key="ComboBoxMinHeight">22</sys:Double>
    <sys:Double x:Key="ListViewItemMinHeight">22</sys:Double>
    <Thickness x:Key="ButtonPadding">8,2,8,3</Thickness>
    <Thickness x:Key="ToggleButtonPadding">8,2,8,3</Thickness>
    <Thickness x:Key="RepeatButtonPadding">4,2,4,2</Thickness>
    <Thickness x:Key="TextControlThemePadding">6,2,6,2</Thickness>

    <!-- The Fluent theme doesn't style group boxes; the classic one has a bright white frame -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource GroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" Margin="4,0,0,3"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{StaticResource HeadingTextBrush}" />
                        <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The toolkit's number boxes aren't styled by the Fluent theme -->
    <Style TargetType="xctk:IntegerUpDown">
        <Setter Property="Background" Value="{StaticResource ControlFillColorInputActiveBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style TargetType="xctk:DoubleUpDown">
        <Setter Property="Background" Value="{StaticResource ControlFillColorInputActiveBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
