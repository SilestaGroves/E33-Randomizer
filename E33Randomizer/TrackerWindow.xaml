<Window x:Class="E33Randomizer.TrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:E33Randomizer"
        Title="{local:Tr Tr_WindowTitle}"
        Width="1220" Height="800" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0B0A09" Foreground="#E8E0CF"
        FontFamily="Palatino Linotype, Book Antiqua, Georgia"
        FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <!--
        Styled after the game's menus: near-black ink, warm paper-white text, thin gold lines with diamond
        ornaments, and a white brushstroke behind the selected entry. The window draws everything itself, so it looks
        the same in the light and dark themes of the other windows.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="70" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#E8E0CF" />
        <SolidColorBrush x:Key="PaperDim" Color="#A69E8D" />
        <SolidColorBrush x:Key="PaperFaint" Color="#6B645A" />
        <SolidColorBrush x:Key="Gold" Color="#C9A66B" />
        <SolidColorBrush x:Key="GoldDim" Color="#7A6646" />
        <SolidColorBrush x:Key="Line" Color="#3A3329" />
        <SolidColorBrush x:Key="Blood" Color="#C0574C" />
        <SolidColorBrush x:Key="InkText" Color="#16120E" />
        <SolidColorBrush x:Key="Stroke" Color="#ECE4D2" />

        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:InverseBooleanToVisibilityConverter x:Key="Hidden" />
        <local:SpacedCapsConverter x:Key="Caps" />

        <!-- A white brushstroke, as behind the selected entry of the game's menus -->
        <Geometry x:Key="BrushStroke">M1.5,7 C8,3.2 20,4.1 35,3.1 C55,1.9 74,3.6 91,2.6 C96,2.4 99.2,4.6 99,7.6 L98.2,11.4 C99.4,14.6 96.6,17.1 92.4,16.9 C74,17.8 55,15.9 35,17.6 C20,18.8 8.4,18.1 3.2,15.9 C0.3,14.2 0.8,10.1 1.5,7 Z</Geometry>
        <Geometry x:Key="Bristles">M58,1.2 C68,0.7 79,1 88,0.6 M12,18.9 C22,19.6 34,19.2 46,19.7 M93,18.3 C96,18.6 98,18.2 99.6,17.6</Geometry>
        <Geometry x:Key="Diamond">M5,0 L10,5 L5,10 L0,5 Z</Geometry>

        <!-- Scroll bars: a thin gold line -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Rectangle Width="1" Fill="{StaticResource Line}" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle x:Name="Bar" Width="3" Fill="{StaticResource GoldDim}" RadiusX="1.5" RadiusY="1.5" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Fill" Value="{StaticResource Gold}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Margin="0,0,10,0" CanContentScroll="False" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A check mark in the shape of a diamond: hollow, filled with gold when checked -->
        <Style x:Key="DiamondCheck" TargetType="CheckBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,4,0,0">
                                <Path x:Name="Outline" Data="{StaticResource Diamond}" Stretch="Fill"
                                      Stroke="{StaticResource GoldDim}" StrokeThickness="1.1" />
                                <Path x:Name="Fill" Data="{StaticResource Diamond}" Stretch="Fill" Margin="2.5"
                                      Fill="{StaticResource Gold}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain text button with a gold underline on hover -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PaperDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="2,2,2,5" HorizontalAlignment="Center" />
                            <Rectangle x:Name="Underline" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Gold}"
                                       Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Paper}" />
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small round "?" that reveals a hint -->
        <Style x:Key="HintButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="18" Height="18">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource GoldDim}" StrokeThickness="1" Fill="Transparent" />
                            <TextBlock x:Name="Mark" Text="?" FontSize="11" Foreground="{StaticResource Gold}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Gold}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Gold}" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource InkText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window buttons in the title area -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PaperDim}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A region in the list; the selected one gets the brushstroke -->
        <Style x:Key="RegionButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section heading: small spaced capitals between two fading gold lines -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <LinearGradientBrush x:Key="FadeLeft" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00C9A66B" Offset="0" />
            <GradientStop Color="#997A6646" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FadeRight" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#997A6646" Offset="0" />
            <GradientStop Color="#00C9A66B" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- Background: warm ink with a soft light from above, and a faint "33" -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.05" GradientOrigin="0.5,0.05" RadiusX="0.9" RadiusY="1.1">
                    <GradientStop Color="#231F1A" Offset="0" />
                    <GradientStop Color="#13110F" Offset="0.55" />
                    <GradientStop Color="#0A0908" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock Text="33" FontSize="560" FontStyle="Italic" Foreground="#E8E0CF" Opacity="0.025"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,-150" IsHitTestVisible="False" />

        <!-- Double frame with diamonds in the corners -->
        <Border Margin="10" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Opacity="0.55" IsHitTestVisible="False" />
        <Border Margin="14" BorderBrush="{StaticResource Line}" BorderThickness="1" IsHitTestVisible="False" />
        <Path Data="{StaticResource Diamond}" Fill="{StaticResource Gold}" Width="9" Height="9" Stretch="Fill"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" IsHitTestVisible="False" />
        <Path Data="{StaticResource Diamond}" Fill="{StaticResource Gold}" Width="9" Height="9" Stretch="Fill"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" IsHitTestVisible="False" />
        <Path Data="{StaticResource Diamond}" Fill="{StaticResource Gold}" Width="9" Height="9" Stretch="Fill"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6" IsHitTestVisible="False" />
        <Path Data="{StaticResource Diamond}" Fill="{StaticResource Gold}" Width="9" Height="9" Stretch="Fill"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" IsHitTestVisible="False" />

        <Grid Margin="34,22,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Grid Grid.Row="0" Height="62">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{StaticResource GoldDim}" Margin="2,0,0,2">
                        <TextBlock.Text>
                            <Binding Source="Clair Obscur · Expedition 33" Converter="{StaticResource Caps}" />
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="30" Foreground="{StaticResource Paper}"
                               Text="{Binding [Tr_Title], Source={x:Static local:Loc.Instance}, Converter={StaticResource Caps}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="{Binding SeedText}" HorizontalAlignment="Right" Foreground="{StaticResource PaperDim}" FontSize="13" />
                        <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" Foreground="{StaticResource Gold}" FontSize="13" />
                    </StackPanel>
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click" ToolTip="{local:Tr Tr_Minimize}">
                        <Rectangle Width="12" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click" ToolTip="{local:Tr Tr_Maximize}">
                        <Path Data="{StaticResource Diamond}" Width="11" Height="11" Stretch="Fill" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="CloseButton_Click" ToolTip="{local:Tr Tr_Close}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Width="11" Height="11" Stretch="Fill" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Ornament under the title -->
            <Grid Grid.Row="1" Margin="0,6,0,14" Height="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource FadeLeft}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                    <Path Data="{StaticResource Diamond}" Fill="{StaticResource GoldDim}" Width="5" Height="5" Stretch="Fill" VerticalAlignment="Center" />
                    <Path Data="{StaticResource Diamond}" Stroke="{StaticResource Gold}" StrokeThickness="1" Width="11" Height="11"
                          Stretch="Fill" Margin="6,0" VerticalAlignment="Center" />
                    <Path Data="{StaticResource Diamond}" Fill="{StaticResource GoldDim}" Width="5" Height="5" Stretch="Fill" VerticalAlignment="Center" />
                </StackPanel>
                <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource FadeRight}" VerticalAlignment="Center" />
            </Grid>

            <!-- Key items | regions | the selected region -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="1" Fill="{StaticResource Line}" />
                <Rectangle Grid.Column="3" Fill="{StaticResource Line}" />

                <!-- Key items -->
                <DockPanel Grid.Column="0" Margin="0,0,18,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionTitle}" HorizontalAlignment="Left" Margin="0"
                                   Text="{Binding [Tr_KeyItems], Source={x:Static local:Loc.Instance}, Converter={StaticResource Caps}}" />
                        <TextBlock Text="{Binding KeyItemsText}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource PaperDim}" />
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding KeyItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TrackerKeyItemViewModel}">
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox Style="{StaticResource DiamondCheck}" IsChecked="{Binding Found}"
                                                  ToolTip="{local:Tr Tr_KeyItemTip}">
                                            <TextBlock x:Name="Name" Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource PaperDim}" />
                                        </CheckBox>
                                        <Button Grid.Column="1" Style="{StaticResource HintButton}" VerticalAlignment="Top" Margin="6,1,0,0"
                                                Click="HintButton_Click" ToolTip="{local:Tr Tr_HintTip}"
                                                Visibility="{Binding CanHint, Converter={StaticResource Visible}}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="22,2,0,0" Text="{Binding Hint}"
                                                   TextWrapping="Wrap" FontStyle="Italic" FontSize="12.5" Foreground="{StaticResource Gold}"
                                                   Visibility="{Binding HintRevealed, Converter={StaticResource Visible}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Found}" Value="True">
                                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Paper}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Regions by act -->
                <DockPanel Grid.Column="2" Margin="18,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" HorizontalAlignment="Left" Margin="0,0,0,12"
                               Text="{Binding [Tr_Regions], Source={x:Static local:Loc.Instance}, Converter={StaticResource Caps}}" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Acts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TrackerActViewModel}">
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Height="1" Fill="{StaticResource FadeLeft}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="11.5"
                                                       Foreground="{StaticResource PaperDim}"
                                                       Text="{Binding Title, Converter={StaticResource Caps}}" />
                                            <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource FadeRight}" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Regions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:TrackerRegionViewModel}">
                                                    <Button Style="{StaticResource RegionButton}" Click="RegionButton_Click">
                                                        <Grid Height="34" Background="Transparent">
                                                            <Path x:Name="Stroke" Data="{StaticResource BrushStroke}" Stretch="Fill"
                                                                  Fill="{StaticResource Stroke}" Margin="-6,3,-4,3" Visibility="Collapsed" />
                                                            <Path x:Name="Bristles" Data="{StaticResource Bristles}" Stretch="Fill"
                                                                  Stroke="{StaticResource Stroke}" StrokeThickness="0.8" Opacity="0.7"
                                                                  Margin="-6,1,-4,1" Visibility="Collapsed" />
                                                            <Grid Margin="8,0,8,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Path x:Name="Done" Data="{StaticResource Diamond}" Width="7" Height="7" Stretch="Fill"
                                                                      Fill="{StaticResource Gold}" VerticalAlignment="Center" Visibility="Hidden" />
                                                                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource PaperFaint}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock x:Name="Count" Grid.Column="2" Text="{Binding ProgressText}" FontSize="12"
                                                                           VerticalAlignment="Center" Foreground="{StaticResource PaperFaint}" />
                                                            </Grid>
                                                            <Rectangle x:Name="Bar" Height="1" VerticalAlignment="Bottom" Margin="24,0,8,4"
                                                                       Fill="{StaticResource Line}" />
                                                            <Rectangle x:Name="Progress" Height="1" VerticalAlignment="Bottom" Margin="24,0,8,4"
                                                                       Fill="{StaticResource Gold}" RenderTransformOrigin="0,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                        </Grid>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Visited}" Value="True">
                                                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Paper}" />
                                                            <Setter TargetName="Count" Property="Foreground" Value="{StaticResource PaperDim}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                            <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Gold}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Stroke" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Bristles" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource InkText}" />
                                                            <Setter TargetName="Count" Property="Foreground" Value="{StaticResource InkText}" />
                                                            <Setter TargetName="Done" Property="Fill" Value="{StaticResource InkText}" />
                                                            <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
                                                            <Setter TargetName="Progress" Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- The selected region -->
                <Grid Grid.Column="4" Margin="26,0,0,0">
                    <TextBlock Text="{local:Tr Tr_PickRegion}" FontStyle="Italic" FontSize="16" Foreground="{StaticResource PaperFaint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource Hidden}}" />
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                        <StackPanel DockPanel.Dock="Top">
                            <Grid>
                                <TextBlock Text="{Binding SelectedRegion.Name}" FontSize="28" Foreground="{StaticResource Paper}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,180,0" />
                                <CheckBox Style="{StaticResource DiamondCheck}" IsChecked="{Binding HideDone}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PaperDim}">
                                    <TextBlock Text="{local:Tr Tr_HideDone}" FontSize="13" />
                                </CheckBox>
                            </Grid>
                            <TextBlock Text="{Binding RegionSubtitle}" FontSize="13" FontStyle="Italic" Foreground="{StaticResource PaperDim}"
                                       Margin="1,2,0,0" />
                            <TextBlock Text="{local:Tr Tr_NamesNote}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource PaperFaint}"
                                       Margin="1,2,0,0" />
                            <Grid Margin="0,12,0,12" Height="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource Diamond}" Fill="{StaticResource Gold}" Width="6" Height="6" Stretch="Fill"
                                      VerticalAlignment="Center" />
                                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource FadeRight}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding SelectedRegion.Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TrackerCheckViewModel}">
                                        <Grid x:Name="Row" Margin="0,0,0,10" Visibility="{Binding Visible, Converter={StaticResource Visible}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource DiamondCheck}" IsChecked="{Binding Done}">
                                                <StackPanel>
                                                    <TextBlock x:Name="Name" Text="{Binding DisplayName}" TextWrapping="Wrap" ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding LockText}" FontSize="12.5" FontStyle="Italic" Foreground="{StaticResource Blood}"
                                                               Visibility="{Binding Locked, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </CheckBox>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"
                                                       FontSize="10.5" Foreground="{StaticResource GoldDim}"
                                                       Text="{Binding TypeLabel, Converter={StaticResource Caps}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                <Setter TargetName="Name" Property="Foreground" Value="{StaticResource PaperFaint}" />
                                                <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource Line}" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource DiamondCheck}" IsChecked="{Binding AutoTrack}" ToolTip="{local:TrTip Tr_AutoTrackTip}">
                        <TextBlock Text="{local:Tr Tr_AutoTrack}" />
                    </CheckBox>
                    <TextBlock Text="{Binding SaveStatus}" Margin="18,0,0,0" FontStyle="Italic" FontSize="13"
                               Foreground="{StaticResource PaperFaint}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource TextButton}" Click="MiniModeButton_Click" ToolTip="{local:TrTip Tr_MiniModeTip}">
                        <TextBlock Text="{local:Tr Tr_MiniMode}" />
                    </Button>
                    <Path Data="{StaticResource Diamond}" Fill="{StaticResource GoldDim}" Width="4" Height="4" Stretch="Fill"
                          Margin="14,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TextButton}" Click="OpenSeedButton_Click" ToolTip="{local:TrTip Tr_OpenSeedTip}">
                        <TextBlock Text="{local:Tr Tr_OpenSeed}" />
                    </Button>
                    <Path Data="{StaticResource Diamond}" Fill="{StaticResource GoldDim}" Width="4" Height="4" Stretch="Fill"
                          Margin="14,0" VerticalAlignment="Center" />
                    <Button x:Name="ResetButton" Style="{StaticResource TextButton}" Click="ResetButton_Click">
                        <TextBlock x:Name="ResetText" Text="{local:Tr Tr_Reset}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
