<Window x:Class="E33Randomizer.CustomPlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:E33Randomizer"
        Title="{local:Tr Cp_Title}" Height="820" Width="900"
        MinHeight="820" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Row="0" Header="{local:Tr Cp_SpecialRules}" Margin="10, 0, 5, 0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            
                <!-- Not Randomized Object Selection -->
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <Label Content="{local:Tr Cp_NotRandomized}" ToolTip="{local:TrTip Cp_NotRandomizedTip}" FontWeight="Bold"/>
                    <ComboBox Name="NotRandomizedObjectsSelectionComboBox" 
                              Margin="0,0,0,0"
                              SelectionChanged="NotRandomizedObjectsComboBox_SelectionChanged"/>
                    <ListBox Name="NotRandomizedObjectsListBox"
                             SelectionMode="Single"
                             Height="75" 
                             SelectionChanged="NotRandomizedObjectsListBox_SelectionChanged"/>
                    
                    <Button Name="RemoveNotRandomizedObjectButton"
                            Content="{local:Tr Cp_Remove}" 
                            Width="100" 
                            Height="28" 
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"
                            Click="RemoveNotRandomizedObjectButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            
                <!-- Excluded Object Selection -->
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <Label Content="{local:Tr Cp_Excluded}" ToolTip="{local:TrTip Cp_ExcludedTip}" FontWeight="Bold"/>
                    <ComboBox Name="ExcludedObjectsComboBox" 
                              Margin="0,0,0,0"
                              SelectionChanged="ExcludedObjectsComboBox_SelectionChanged"/>
                    <ListBox Name="ExcludedObjectsListBox"
                             SelectionMode="Single"
                             Height="75" 
                             SelectionChanged="ExcludedObjectsListBox_SelectionChanged"/>
                    
                    <Button Name="RemoveExcludedObjectButton"
                            Content="{local:Tr Cp_Remove}" 
                            Width="100" 
                            Height="28" 
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"
                            Click="RemoveExcludedObjectButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        
        <!-- Quick Presets Section -->
<GroupBox Grid.Row="0" Grid.Column="1" Header="{local:Tr Cp_QuickPresets}" Margin="5, 0, 10, 0">
    <StackPanel Margin="10">
        <!-- Oops All Row -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Name="OopsAllButton" Content="{local:Tr Cp_OopsAll}" ToolTip="{local:TrTip Cp_OopsAllTip}" Width="80" Height="30" 
                    Click="OopsAllButton_Click" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" Name="OopsAllObjectComboBox" Height="30"/>
        </Grid>
        
        <!-- Preset Buttons Grid (3x2) -->
        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Row="0" Grid.Column="0" Name="PresetButton1" HorizontalAlignment="Stretch" Content="Split categories (default)" Height="35" 
                    Margin="0,0,5,5" Click="PresetButton_Click" Tag="Data/presets/default.json"/>
            <Button Grid.Row="0" Grid.Column="1" Name="PresetButton2" HorizontalAlignment="Stretch" Content="Total randomness" Height="35" 
                    Margin="5,0,0,5" Click="PresetButton_Click" Tag="Data/presets/total_random.json"/>
            <Button Grid.Row="1" Grid.Column="0" Name="PresetButton3" HorizontalAlignment="Stretch" Content="10% of regular enemies are bosses" Height="35"
                    Margin="0,0,5,5" Click="PresetButton_Click" Tag="Data/presets/10_percent.json"/>
            <Button Grid.Row="1" Grid.Column="1" Name="PresetButton4" HorizontalAlignment="Stretch" Content="Make every enemy a boss" Height="35" 
                    Margin="5,0,0,5" Click="PresetButton_Click" Tag="Data/presets/everyone_is_a_boss.json"/>
            <Button Grid.Row="2" Grid.Column="0" Name="PresetButton5" HorizontalAlignment="Stretch" Content="Custom preset 1" Height="35" 
                    Margin="0,0,5,5" Click="PresetButton_Click" Tag="Data/presets/custom_1.json"/>
            <Button Grid.Row="2" Grid.Column="1" Name="PresetButton6" HorizontalAlignment="Stretch" Content="Custom preset 2" Height="35" 
                    Margin="5,0,0,5" Click="PresetButton_Click" Tag="Data/presets/custom_2.json"/>
        </Grid>
        
    </StackPanel>
</GroupBox>
        
<GroupBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Header="{local:Tr Cp_CustomPlacement}" Margin="10" MinHeight="300" MaxHeight="300">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Column - Object Selection -->
        <GroupBox Grid.Column="0" Header="{local:Tr Cp_Selected}" Margin="0,0,5,0">
                <ListBox Name="CustomPlacementObjectListBox" 
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CustomPlacementObjectListBox_SelectionChanged"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    </ListBox>
        </GroupBox>
        
        <!-- Right Column - Frequency Adjustment for Selected Object -->
        <GroupBox Grid.Column="1" Header="{local:Tr Cp_ReplacedBy}" ToolTip="{local:TrTip Cp_ReplacedByTip}" Margin="5,0,0,0">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Selected Object Display -->
                <TextBlock Grid.Row="0" Name="SelectedObjectDisplay" 
                           Text="{local:Tr Cp_NothingSelected}" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>
                
                <!-- Scrollable Container for Custom Placement Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="CustomPlacementRowsContainer"/>
                </ScrollViewer>
                
                <!-- Add Row Button -->
                <Button Grid.Row="2" Name="AddCustomPlacementRowButton" HorizontalAlignment="Stretch" 
                        Content="{local:Tr Cp_AddPlacementRow}" 
                        Height="35" Margin="0,10,0,0" 
                        Click="AddCustomPlacementRowButton_Click"
                        Background="{DynamicResource SuccessButtonBrush}" Foreground="{DynamicResource SuccessButtonTextBrush}" FontWeight="Bold"
                        IsEnabled="False"/>
            </Grid>
        </GroupBox>
    </Grid>
</GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="0" Header="{local:Tr Cp_Frequency}" ToolTip="{local:TrTip Cp_FrequencyTip}" Margin="5, 0, 10, 0" MaxHeight="180">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
                <!-- Scrollable Container for Frequency Rows -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="150">
                    <StackPanel Name="FrequencyRowsContainer"/>
                </ScrollViewer>
        
                <!-- Add Row Button -->
                <Button Grid.Row="1" Name="AddFrequencyRowButton" HorizontalAlignment="Stretch" Content="{local:Tr Cp_AddFrequencyRow}" 
                        Height="35" Margin="0,10,0,0" Click="AddFrequencyRowButton_Click"
                        Background="{DynamicResource SuccessButtonBrush}" Foreground="{DynamicResource SuccessButtonTextBrush}" FontWeight="Bold"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="1" Header="{local:Tr Cp_PresetJson}" Margin="5, 0, 10, 0" MaxHeight="180" MinHeight="180">
            <TextBox
                Name="PresetJsonTextBox"
                Text=""
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Height="150" 
                Margin="5"/>
        </GroupBox>
        <GroupBox Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{DynamicResource GroupBorderBrush}">
        <!-- Close Button -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Name="LoadPresetButton" 
                    Content="{local:Tr Cp_LoadPreset}" 
                    Width="130" 
                    Height="35" 
                    HorizontalAlignment="Center"
                    Margin="0,10,20,10"
                    Click="LoadPresetButton_Click"/>
        
        <Button Grid.Column="1"
                Name="SavePresetButton" 
                Content="{local:Tr Cp_SavePreset}" 
                Width="130" 
                Height="35" 
                HorizontalAlignment="Center"
                Margin="0,10,20,10"
                Click="SavePresetButton_Click"/>
        <Button Grid.Column="2"
                Name="CloseButton" 
                Content="{local:Tr Cp_Close}" 
                Width="100" 
                Height="35" 
                HorizontalAlignment="Center"
                Margin="0,10,20,10"
                Click="CloseButton_Click"/>
        </Grid>
    </GroupBox>
        </Grid>
</Window>