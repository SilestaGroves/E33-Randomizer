<UserControl x:Class="E33Randomizer.RandomizeItemsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:E33Randomizer"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
        <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <CheckBox Content="{local:Tr It_Randomize}" ToolTip="{local:TrTip It_RandomizeTip}"
                                  IsChecked="{Binding RandomizeItems}"
                                  Margin="0,0,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_Visible}" ToolTip="{local:TrTip It_VisibleTip}"
                                  IsChecked="{Binding MakeEveryItemVisible}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_CutContent}" ToolTip="{local:TrTip It_CutContentTip}"
                                  IsChecked="{Binding IncludeCutContentItems}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_PaintedPower}" ToolTip="{local:TrTip It_PaintedPowerTip}"
                                  IsChecked="{Binding EnsurePaintedPowerFromPaintress}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <CheckBox Name="RandomizeStartingWeaponsCheckBox"
                                Content="{local:Tr It_StartWeapons}" ToolTip="{local:TrTip It_StartWeaponsTip}"
                                      IsChecked="{Binding RandomizeStartingWeapons}"
                                      Margin="0,6,0,0"
                                      FontSize="14" />
                            <TextBlock
                                Text="{local:Tr It_StartWeaponsWarning}"
                                Foreground="{DynamicResource WarningTextBrush}"
                                FontWeight="Bold"
                                Margin="10,6,0,0"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="800" 
                                Visibility="{Binding IsChecked, ElementName=RandomizeStartingWeaponsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <CheckBox Content="{local:Tr It_StartCosmetics}" ToolTip="{local:TrTip It_StartCosmeticsTip}"
                                  IsChecked="{Binding RandomizeStartingCosmetics}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_PrologueGear}" ToolTip="{local:TrTip It_PrologueGearTip}"
                                  IsChecked="{Binding IncludeGearInPrologue}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_GestralBeach}" ToolTip="{local:TrTip It_GestralBeachTip}"
                                  IsChecked="{Binding RandomizeGestralBeachRewards}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_ChecksSizeNonRandom}" ToolTip="{local:TrTip It_ChecksSizeNonRandomTip}"
                                  IsChecked="{Binding ChangeSizesOfNonRandomizedChecks}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_KeyLogic}"
                                  ToolTip="{local:TrTip It_KeyLogicTip}"
                                  IsChecked="{Binding GuaranteeKeyItemAccess}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <CheckBox Content="{local:Tr It_KeyRepetition}" ToolTip="{local:TrTip It_KeyRepetitionTip}"
                                  IsChecked="{Binding ReduceKeyItemRepetition}"
                                  Margin="0,6,0,0"
                                  FontSize="14" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="ChangeMerchantInventoryLockedCheckBox"
                                          Grid.Row="4"
                                          Content="{local:Tr It_MerchantLocked}" ToolTip="{local:TrTip It_MerchantLockedTip}"
                                          IsChecked="{Binding ChangeMerchantInventoryLocked}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_WithProbability}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Name="MerchantInventoryLockedChancePercentTextBox"
                                                        Text="{Binding MerchantInventoryLockedChancePercent}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="3" />
                                    <Label VerticalAlignment="Center" Content="%"
                                           FontSize="14" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="ChangeMerchantInventorySizeCheckBox"
                                          Grid.Row="4"
                                          Content="{local:Tr It_MerchantSize}"
                                          IsChecked="{Binding ChangeMerchantInventorySize}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ChangeMerchantInventorySizeCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_Between}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Name="MerchantInventorySizeMinTextBox"
                                                        Text="{Binding MerchantInventorySizeMin}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_And}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Name="MerchantInventorySizeMaxTextBox"
                                                        Text="{Binding MerchantInventorySizeMax}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="NumberOfLootDropsSizeCheckBox"
                                          Grid.Row="4"
                                          Content="{local:Tr It_LootDrops}"
                                          IsChecked="{Binding ChangeNumberOfLootDrops}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=NumberOfLootDropsSizeCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_Between}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Name="LootDropsNumberMinTextBox"
                                                        Text="{Binding LootDropsNumberMin}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="0"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_And}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Name="LootDropsNumberMaxTextBox"
                                                        Text="{Binding LootDropsNumberMax}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="0"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="ChangeNumberOfTowerRewardsCheckBox"
                                          Content="{local:Tr It_Tower}"
                                          IsChecked="{Binding ChangeNumberOfTowerRewards}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ChangeNumberOfTowerRewardsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_Between}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding TowerRewardsNumberMin}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_And}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding TowerRewardsNumberMax}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="ChangeNumberOfChestContentsCheckBox"
                                          Content="{local:Tr It_Chests}"
                                          IsChecked="{Binding ChangeNumberOfChestContents}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ChangeNumberOfChestContentsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_Between}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding ChestContentsNumberMin}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_And}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding ChestContentsNumberMax}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="ChangeNumberOfActionRewardsCheckBox"
                                          Content="{local:Tr It_Actions}"
                                          IsChecked="{Binding ChangeNumberOfActionRewards}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ChangeNumberOfActionRewardsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_Between}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding ActionRewardsNumberMin}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_And}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding ActionRewardsNumberMax}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Name="ChangeQuantityOfItemsCheckBox"
                                          Content="{local:Tr It_Quantity}"
                                          IsChecked="{Binding ChangeItemQuantity}"
                                          Margin="0,6,0,0"
                                          FontSize="14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                            Visibility="{Binding IsChecked, ElementName=ChangeQuantityOfItemsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_Between}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding ItemQuantityMin}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                    <Label VerticalAlignment="Center" Content="{local:Tr It_And}"
                                           FontSize="14" />
                                    <xctk:IntegerUpDown Text="{Binding ItemQuantityMax}"
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Maximum="99"
                                                        Minimum="1"
                                                        Height="20"
                                                        Width="50"
                                                        FontSize="14"
                                                        MaxLength="2" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Button Name="CustomItemPlacementButton"
                                Content="{local:Tr It_CustomizePlacement}" ToolTip="{local:TrTip It_CustomizePlacementTip}"
                                Width="500"
                                Height="50"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,20"
                                Background="{DynamicResource AccentButtonBrush}" Foreground="{DynamicResource AccentButtonTextBrush}"
                                Click="CustomPlacementButton_Click" 
                                Tag="Item"/>
                        <Button Name="EditChecksButton"
                                Content="{local:Tr It_EditChecks}" ToolTip="{local:TrTip It_EditChecksTip}"
                                Width="500"
                                Height="50"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,20"
                                Background="{DynamicResource AccentButtonBrush}" Foreground="{DynamicResource AccentButtonTextBrush}"
                                Click="EditButton_Click" 
                                Tag="Item"/>
                    </StackPanel>
                </Grid>
    </Grid>
</ScrollViewer>
</UserControl>
