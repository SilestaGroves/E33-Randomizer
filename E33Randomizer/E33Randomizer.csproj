<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ApplicationIcon>e33randoicon.ico</ApplicationIcon>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Release builds get their version from the git tag (see .github/workflows/release.yml);
             0.0.0 marks a development build, which isn't updated automatically -->
        <Version Condition="'$(Version)' == ''">0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Extended.Wpf.Toolkit" Version="4.7.25104.5739" />
      <PackageReference Include="GenericReader" Version="2.2.4" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\external\UAssetAPI\UAssetAPI\UAssetAPI.csproj" />
    </ItemGroup>
    <!-- Game data and the packing/save tools go next to the exe, so a fresh clone runs as is -->
    <ItemGroup>
        <None Update="Data\**\*" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\tools\*.exe" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
